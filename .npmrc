# DocuTrust dependency confusion defense (Project 2, deliverable 5).
#
# What this does, in one sentence: any package whose name starts with
# @docutrust/ may ONLY come from the private registry below — npm will
# never consult the public registry for that scope, so a malicious
# public package with an internal-sounding name cannot be silently
# pulled in. If the private registry is unreachable, resolution fails
# loudly (fail-closed) instead of falling back to npmjs.org.
#
# In a real org this URL points at the org's private registry (GitHub
# Packages, Verdaccio, Artifactory, ...). The demo of this defense
# working — and the control proving what happens without it — is in
# evidence/13-scope-demo/.

@docutrust:registry=https://npm.docutrust.internal/

# Explicit default for everything else (registry.npmjs.org is npm's
# default anyway; spelled out so resolution is never implicit).
registry=https://registry.npmjs.org/
